{
  "name": "wa-turbo",
  "productName": "WA Turbo",
  "version": "0.4.0",
  "description": "Multi-account WhatsApp reader with AI summaries, reports and reply-debt tracking: Claude, other AI plans, a free Gemini key or a local model. Runs locally on macOS and Windows.",
  "private": true,
  "author": "Kevin Farel",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:send": "node scripts/check-send.mjs",
    "postgres": "node scripts/prepare-postgres.mjs",
    "dist": "npm run lint:send && npm run postgres && npm run build && electron-builder --mac --arm64",
    "release:patch": "npm version patch -m \"Release v%s\"",
    "release:minor": "npm version minor -m \"Release v%s\"",
    "release:major": "npm version major -m \"Release v%s\"",
    "postgres:win": "node scripts/prepare-postgres-win.mjs",
    "dist:win": "npm run lint:send && npm run postgres:win && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "baileys": "7.0.0-rc14",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
